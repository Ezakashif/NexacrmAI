APP_NAME=NexaCRM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the URL you open in the browser (include port), e.g. http://localhost:8000
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production behind a process manager: LOG_CHANNEL=stderr
# LOG_STDERR_FORMATTER="\Monolog\Formatter\JsonFormatter"

# Local default is sqlite. Production typically uses mysql (DB_URL or discrete DB_* vars).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nexacrm
# DB_USERNAME=root
# DB_PASSWORD=
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true behind HTTPS in production
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
# Uploads use the "public" disk (avatars, logos). Persist storage/app/public
# (volume or backup) or set FILESYSTEM_DISK=s3 with AWS_* credentials.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel 11+: CACHE_STORE (not CACHE_DRIVER).
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Default "log" writes mail to storage/logs — it does NOT reach inboxes.
# Local inbox: run Mailpit (or similar) and use:
#   MAIL_MAILER=smtp
#   MAIL_HOST=127.0.0.1
#   MAIL_PORT=1025
# Production: smtp / ses / postmark / resend with real credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public marketing site (optional overrides)
MARKETING_BRAND_NAME="${APP_NAME}"
MARKETING_TAGLINE="A Modern Multi-Tenant CRM for Growing Businesses"
MARKETING_CONTACT_EMAIL=hello@example.com
MARKETING_CONTACT_PHONE="+1 (555) 010-2000"
# MARKETING_CONTACT_ADDRESS=
# MARKETING_SOCIAL_TWITTER=
# MARKETING_SOCIAL_LINKEDIN=
# MARKETING_SOCIAL_FACEBOOK=
# MARKETING_SOCIAL_GITHUB=

# Lead follow-up reminders (email + in-app notifications)
LEAD_FOLLOW_UP_REMINDERS_ENABLED=true
LEAD_FOLLOW_UP_REMINDER_TIME=08:00
LEAD_FOLLOW_UP_DEFAULT_TIME=09:00
LEAD_FOLLOW_UP_REMINDER_1D_ENABLED=true
LEAD_FOLLOW_UP_REMINDER_2H_ENABLED=true
LEAD_FOLLOW_UP_REMINDER_DUE_ENABLED=true
LEAD_FOLLOW_UP_REMINDER_OVERDUE_ENABLED=true
LEAD_FOLLOW_UP_REMINDER_OVERDUE_REPEAT_DAYS=1

# Task due and overdue reminders (in-app notifications)
TASK_REMINDERS_ENABLED=true
TASK_REMINDER_TIME=08:15
TASK_REMINDER_DUE_ENABLED=true
TASK_REMINDER_OVERDUE_ENABLED=true
TASK_REMINDER_OVERDUE_REPEAT_DAYS=1

# First-run Super Admin (optional). Both email and password are required to create
# an account during `php artisan db:seed`. Prefer:
#   php artisan nexacrm:create-super-admin
# Never commit a real password. Remove SETUP_SUPERADMIN_PASSWORD after first-run
# and before `php artisan config:cache`.
SETUP_SUPERADMIN_NAME="Super Admin"
SETUP_SUPERADMIN_EMAIL=
SETUP_SUPERADMIN_PASSWORD=

# Optional live demo tenant. Leave DEMO_SEED=false on buyer production installs.
# DEMO_SEED_PASSWORD is required for DemoDataSeeder and php artisan demo:reset.
# Never commit the real value. Do not put this password in HTML, JS, or docs.
DEMO_SEED=false
DEMO_SEED_PASSWORD=
# Daily demo:reset via schedule:run. Leave false until you explicitly want resets.
DEMO_RESET_ENABLED=false

# Website form webhook (server-to-server only; never expose the secret in browser JS)
WEBSITE_LEAD_WEBHOOK_SECRET=
WEBSITE_LEAD_CREATED_BY_EMAIL=admin@example.com
WEBSITE_LEAD_RATE_LIMIT=10

# Omnichannel Channels Engine
CHANNELS_WEBHOOK_QUEUE=channels

# Meta / Facebook Lead Ads (optional)
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------------------
# Production checklist (set in your host — do not commit)
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=base64:...          # php artisan key:generate --show
# APP_URL=https://YOUR_DOMAIN
# APP_TIMEZONE=UTC
# LOG_CHANNEL=stderr
# LOG_LEVEL=info
# DB_CONNECTION=mysql
# SESSION_DRIVER=database
# SESSION_SECURE_COOKIE=true
# CACHE_STORE=database
# QUEUE_CONNECTION=database
# FILESYSTEM_DISK=local       # persist storage/app/public, or use s3
# MAIL_MAILER=smtp            # real SMTP / SES / Resend / Postmark
# DEMO_SEED=false
# DEMO_SEED_PASSWORD=         # required before demo:reset / DemoDataSeeder
# SETUP_SUPERADMIN_EMAIL=
# SETUP_SUPERADMIN_PASSWORD=  # remove after first-run; never leave in cached config
